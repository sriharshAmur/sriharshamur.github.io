# Build output from Astro/Vite (CSS, JS, fonts, optimised images): every filename
# carries a content hash, so a changed file always gets a new URL.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Unversioned files keep their URL when they change, so cache them for a day only.
/img/*
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
