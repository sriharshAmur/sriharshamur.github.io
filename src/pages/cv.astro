---
import Base from "../layouts/Base.astro";
import CompanyLogo from "../components/CompanyLogo.astro";
import CvHighlight from "../components/CvHighlight.astro";
import CvIcon, { type CvIconName } from "../components/CvIcon.astro";
import { profile, experience, education, cv, work } from "../data/site";
import "../styles/cv.css";

const selectedProjects = cv.projects.map((selection) => {
  const project = work.find((item) => item.slug === selection.slug);
  if (!project) throw new Error(`Unknown CV project: ${selection.slug}`);
  if (project.cover.type !== "image") throw new Error(`CV project needs a cover image: ${selection.slug}`);
  return { ...project, cover: project.cover, detail: selection.detail, stack: selection.tools };
});
const school = education[0];
const contacts: { icon: CvIconName; label: string; href: string; print?: string }[] = [
  { icon: "mail", label: profile.email, href: `mailto:${profile.email}` },
  { icon: "globe", label: "sriharsh.com", href: "https://sriharsh.com" },
  { icon: "linkedin", label: "LinkedIn", href: profile.links.linkedin, print: " /in/sriharsh-amur" },
  { icon: "github", label: "GitHub", href: profile.links.github, print: " /sriharshAmur" },
];
---

<Base title="CV · Sri Harsh Amur" description={cv.description} active="cv" showFooter={false}>
  <div class="cv-shell">
    <article class="cv" aria-label="Curriculum vitae">
      <header class="cv-head">
        <h1 data-reveal style="--i:0">{profile.name}</h1>
        <p class="cv-lede" data-reveal style="--i:1">{cv.lede}</p>
        <p class="cv-role" data-reveal style="--i:2">{profile.role}<span class="cv-place"><CvIcon name="location" />{profile.location}</span></p>
        <ul class="cv-contact" role="list" data-reveal style="--i:3">
          {contacts.map((item) => (
            <li><a href={item.href}><CvIcon name={item.icon} />{item.label}{item.print && <span class="print-url">{item.print}</span>}</a></li>
          ))}
        </ul>
        <button class="cv-print" type="button" data-print data-reveal style="--i:4">
          <CvIcon name="download" />
          Download PDF
        </button>
      </header>

      <section class="cv-section" aria-labelledby="experience-title">
        <h2 id="experience-title">Experience</h2>
        {experience.map((role) => (
          <div class="job" data-reveal>
            <div class="job-meta">
              <CompanyLogo company={role.logo} />
              <div>
                <h3>{role.company}</h3>
                <p class="job-role">{role.title}</p>
                <p class="when">
                  {role.start} – {role.end}
                  {role.end === "Present" && <span class="now">Now</span>}
                  <span class="where">{role.place}</span>
                </p>
              </div>
            </div>
            <ul class="points">
              {role.points.map((point) => <li><CvHighlight text={point.text} highlight={point.highlight} /></li>)}
            </ul>
          </div>
        ))}
      </section>

      <section class="cv-section" aria-labelledby="skills-title">
        <h2 id="skills-title">Skills</h2>
        <ol class="span" role="list" data-stretch>
          {cv.skills.map((skill, i) => (
            <li class="span-step" data-reveal style={`--i:${i * 2 + 2}`}>
              <span class="span-icon"><CvIcon name={skill.icon as CvIconName} /></span>
              <h3>{skill.label}</h3>
              <p class="span-line">{skill.line}</p>
              <ul class="tags" role="list">{skill.tools.map((tool) => <li>{tool}</li>)}</ul>
            </li>
          ))}
        </ol>
      </section>

      <section class="cv-section" aria-labelledby="projects-title">
        <h2 id="projects-title">Projects</h2>
        <div class="projects">
          {selectedProjects.map((project, i) => (
            <a class="project" data-reveal style={`--i:${i * 2}`} href={`https://sriharsh.com/${project.slug}/`}>
              <div class="project-shot"><img src={project.cover.src} alt="" loading="lazy" width="1600" height="1000" /></div>
              <div class="project-body">
                <div class="project-title">
                  <h3>{project.title}</h3>
                  <span class="project-link">sriharsh.com/{project.slug}<CvIcon name="external" /></span>
                </div>
                <p class="project-detail">{project.detail}</p>
                <ul class="tags" role="list">{project.stack.map((tool) => <li>{tool}</li>)}</ul>
              </div>
            </a>
          ))}
        </div>
      </section>

      <div class="cv-section cv-pair" data-reveal>
        <section aria-labelledby="speaking-title">
          <h2 id="speaking-title">Speaking</h2>
          <div class="credential">
            <span class="credential-icon"><CvIcon name="speaking" /></span>
            <div>
              <h3><a href={cv.speaking.href}>{cv.speaking.title}</a></h3>
              <p class="credential-meta">{cv.speaking.event}, {cv.speaking.place}</p>
              <p class="credential-detail">{cv.speaking.detail}</p>
            </div>
          </div>
        </section>
        <section aria-labelledby="education-title">
          <h2 id="education-title">Education</h2>
          <div class="credential">
            <span class="credential-icon"><CvIcon name="education" /></span>
            <div>
              <h3>{school.detail}</h3>
              <p class="credential-meta">{school.school}, {school.years}</p>
              <p class="credential-detail">{school.place}</p>
            </div>
          </div>
        </section>
      </div>
    </article>
  </div>
</Base>
