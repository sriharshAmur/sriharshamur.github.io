---
interface Props { text: string; highlight?: string; class?: string; }
const { text, highlight, class: className = "cv-highlight" } = Astro.props;
const index = highlight ? text.indexOf(highlight) : -1;
---
{highlight && index >= 0 ? <>{text.slice(0, index)}<mark class={className}>{highlight}</mark>{text.slice(index + highlight.length)}</> : text}
