---
import { work } from "../data/site";
import Cover from "./Cover.astro";
import FloatPreview from "./FloatPreview.astro";
const featured = work.filter((w) => w.featured);
const rest = work.filter((w) => !w.featured);
// The live app, when a project has one on this site.
const liveLink = (w: (typeof work)[number]) => w.links.find((l) => l.href.startsWith("/"));
---

<section class="section work" id="work" aria-labelledby="work-title">
  <div class="wrap">
    <div class="work__head">
      <h2 class="stretch" id="work-title" data-stretch>Selected work</h2>
      <p class="work__lede muted" data-reveal>
        Product work and independent projects, with the thinking, technical decisions and results behind each one.
      </p>
    </div>

    <div class="feats">
      {
        featured.map((item, i) => {
          const live = liveLink(item);
          return (
            <article class:list={["feat", { "feat--flip": i % 2 === 1 }]} data-tilt-scope data-cursor="curious">
              <div class="feat__media" data-feature-media>
                <div class="feat__tilt" data-tilt="5">
                  <Cover item={item} vt />
                  <span class="feat__glare" aria-hidden="true" />
                </div>
              </div>
              <div class="feat__body">
                <div class="feat__meta ui">
                  {i === 0 && <span class="feat__badge">New</span>}
                  <span>
                    {item.kind}, {item.year}
                  </span>
                </div>
                <h3 class="feat__title display" style={`view-transition-name:title-${item.slug}`}>
                  <a class="feat__link" href={`/work/${item.slug}/`}>
                    {item.title}
                  </a>
                </h3>
                <p class="feat__tagline">{item.tagline}</p>
                <p class="feat__summary muted">{item.summary}</p>
                <div class="feat__actions">
                  <span class="feat__more ui" aria-hidden="true">
                    Read the case study
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                  </span>
                  {live && (
                    <a class="btn btn--ghost btn--small feat__app" href={live.href}>
                      {live.label}
                      <svg class="nudge" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg>
                    </a>
                  )}
                </div>
              </div>
            </article>
          );
        })
      }
    </div>

    <ul class="rows" role="list" data-rows>
      {
        rest.map((item, i) => (
          <li class="row" data-reveal style={`--i:${i}`}>
            <a class="row__link" href={`/work/${item.slug}/`} data-row={i}>
              <span class="row__year ui">{item.year}</span>
              <span class="row__main">
                <span class="row__title display" style={`view-transition-name:title-${item.slug}`}>
                  {item.title}
                </span>
                <span class="row__tagline muted">{item.tagline}</span>
              </span>
              <span class="row__kind ui">{item.kind}</span>
              <span class="row__arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M7 17L17 7M9 7h8v8"></path></svg>
              </span>
              <span class="row__cover" aria-hidden="true">
                <Cover item={item} sizes="100vw" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <FloatPreview items={rest} />
</section>

<style>
  .work__head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(3rem, 7vw, 5.5rem);
  }
  @media (min-width: 900px) {
    .work__head {
      grid-template-columns: 1fr 22rem;
      align-items: end;
    }
  }
  .work__lede {
    max-width: 34ch;
  }

  /* Featured projects: big, alternating sides. */
  .feats {
    display: grid;
    gap: clamp(4.5rem, 10vw, 8.5rem);
    margin-bottom: clamp(5rem, 11vw, 9rem);
  }
  .feat {
    position: relative;
    display: grid;
    gap: clamp(1.75rem, 4vw, 4rem);
  }
  @media (min-width: 900px) {
    .feat {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
      align-items: center;
    }
    .feat--flip {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.45fr);
    }
    .feat--flip .feat__media {
      order: 2;
    }
  }
  .feat__media {
    /* --s and --r come from scroll position (site.ts): the cover settles as it arrives. */
    transform: scale(var(--s, 1)) rotate(calc(var(--r, 0deg) * var(--dir, 1)));
    transform-origin: 50% 80%;
  }
  .feat--flip .feat__media {
    --dir: -1;
  }
  .feat__tilt {
    position: relative;
    border-radius: var(--radius-l);
  }
  /* A soft shadow on its own layer, so lifting it only changes opacity. */
  .feat__tilt::before {
    content: "";
    position: absolute;
    inset: 6% 4% -2%;
    z-index: -1;
    border-radius: inherit;
    box-shadow: 0 50px 90px -30px rgb(var(--shadow) / 0.7);
    opacity: calc(0.55 + var(--lift, 0) * 0.45);
  }
  .feat__tilt :global(.cover) {
    border-radius: var(--radius-l);
    box-shadow: 0 2px 6px -2px rgb(var(--shadow) / 0.25);
  }
  .feat__glare {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(
      circle at var(--gx, 50%) var(--gy, 0%),
      rgb(255 255 255 / 0.2),
      rgb(255 255 255 / 0) 55%
    );
    opacity: var(--lift, 0);
  }
  .feat__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: var(--ink-2);
  }
  .feat__badge {
    padding: 0.2em 0.65em;
    border-radius: 999px;
    background: var(--marigold);
    color: var(--on-gold);
    font-weight: 700;
  }
  .feat__title {
    font-size: clamp(2.8rem, 6vw, 5.2rem);
    margin-block: 0.9rem 0.7rem;
    width: fit-content;
  }
  .feat__link {
    text-decoration: none;
    transition: color var(--t-base) var(--ease-out);
  }
  /* The title link covers the whole card; the app link sits above it. */
  .feat__link::after {
    content: "";
    position: absolute;
    inset: -0.75rem;
    z-index: 1;
    border-radius: calc(var(--radius-l) + 0.75rem);
  }
  .feat__link:focus-visible {
    outline: none;
  }
  .feat__link:focus-visible::after {
    outline: 2px solid var(--delft);
    outline-offset: 2px;
  }
  .feat__tagline {
    font-size: clamp(1.25rem, 1.8vw, 1.6rem);
    line-height: 1.35;
    font-style: italic;
    margin-bottom: 1rem;
    text-wrap: balance;
  }
  .feat__summary {
    max-width: 42ch;
  }
  .feat__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 1.75rem;
  }
  .feat__more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: var(--delft);
  }
  .feat__more svg {
    transition: transform var(--t-base) var(--ease-out);
  }
  .feat__app {
    position: relative;
    z-index: 2;
  }
  @media (hover: hover) and (pointer: fine) {
    .feat:hover .feat__more svg {
      transform: translateX(4px);
    }
    .feat:hover .feat__link {
      color: var(--delft);
    }
  }

  /* Project rows */
  .rows {
    border-top: 1px solid var(--line);
  }
  .row {
    border-bottom: 1px solid var(--line);
  }
  .row__link {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: "cover cover" "year arrow" "main main" "kind kind";
    gap: 0.4rem 1.5rem;
    padding-block: clamp(1.5rem, 3vw, 2.4rem);
    text-decoration: none;
    transition: opacity 350ms var(--ease-out);
  }
  @media (min-width: 900px) {
    .row__link {
      grid-template-columns: 9rem 1fr 14rem 2.75rem;
      grid-template-areas: "year main kind arrow";
      align-items: center;
    }
  }
  .row__year {
    grid-area: year;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
    font-size: 0.95rem;
  }
  .row__main {
    grid-area: main;
    display: grid;
    gap: 0.35rem;
  }
  .row__title {
    font-size: clamp(1.9rem, 4.2vw, 3.6rem);
    font-weight: 750;
    width: fit-content;
    transition: font-stretch 450ms var(--ease-out), color var(--t-base) var(--ease-out);
  }
  .row__tagline {
    font-size: 1.05rem;
  }
  .row__kind {
    grid-area: kind;
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .row__arrow {
    grid-area: arrow;
    justify-self: end;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--line);
    transition: background-color var(--t-base) var(--ease-out), color var(--t-base) var(--ease-out),
      transform 400ms var(--ease-out), box-shadow var(--t-base);
  }
  .row__cover {
    grid-area: cover;
    margin-bottom: 1rem;
  }
  @media (min-width: 900px) {
    .row__cover {
      display: none;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .row__link:hover .row__title {
      font-stretch: 118%;
      color: var(--delft);
    }
    .row__link:hover .row__arrow {
      background: var(--ink);
      color: var(--paper);
      box-shadow: none;
      transform: rotate(45deg);
    }
    /* The row you're on stays bright; the others step back. */
    .rows:has(.row__link:hover) .row__link:not(:hover) {
      opacity: 0.45;
    }
  }
</style>
