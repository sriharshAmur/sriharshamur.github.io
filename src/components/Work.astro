---
import { work } from "../data/site";
import Cover from "./Cover.astro";
const [featured, ...rest] = work;
---

<section class="section work" id="work" aria-labelledby="work-title">
  <div class="wrap">
    <div class="work__head">
      <h2 class="stretch" id="work-title" data-stretch>Selected work</h2>
      <p class="work__lede muted" data-reveal>
        Things I've built at work and on my own time. Each one has the problem, what I did, and how it turned out.
      </p>
    </div>

    <a class="feat" href={`/work/${featured.slug}`} data-feature>
      <div class="feat__media" data-feature-media>
        <Cover item={featured} vt eager />
      </div>
      <div class="feat__body">
        <div class="feat__meta ui">
          <span class="feat__badge">New</span>
          <span>{featured.kind}, {featured.year}</span>
        </div>
        <h3 class="feat__title display" style={`view-transition-name:title-${featured.slug}`}>{featured.title}</h3>
        <p class="feat__tagline">{featured.tagline}</p>
        <p class="feat__summary muted">{featured.summary}</p>
        <span class="feat__more ui">
          Read the case study
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </span>
      </div>
    </a>

    <ul class="rows" role="list" data-rows>
      {
        rest.map((item, i) => (
          <li class="row" data-reveal style={`--i:${i}`}>
            <a class="row__link" href={`/work/${item.slug}`} data-row={i}>
              <span class="row__year ui">{item.year}</span>
              <span class="row__main">
                <span class="row__title display" style={`view-transition-name:title-${item.slug}`}>
                  {item.title}
                </span>
                <span class="row__tagline muted">{item.tagline}</span>
              </span>
              <span class="row__kind ui">{item.kind}</span>
              <span class="row__arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M7 17L17 7M9 7h8v8"></path></svg>
              </span>
              <span class="row__cover" aria-hidden="true">
                <Cover item={item} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="float" aria-hidden="true" data-float>
    <div class="float__inner" data-float-inner>
      {
        rest.map((item, i) => (
          <div class="float__slide" data-slide={i}>
            <Cover item={item} />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .work__head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }
  @media (min-width: 900px) {
    .work__head {
      grid-template-columns: 1fr 22rem;
      align-items: end;
    }
  }
  .work__lede {
    max-width: 34ch;
  }

  /* Featured project */
  .feat {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    text-decoration: none;
    margin-bottom: clamp(3rem, 7vw, 5rem);
  }
  @media (min-width: 900px) {
    .feat {
      grid-template-columns: 1.45fr 1fr;
      align-items: center;
    }
  }
  .feat__media {
    transform: scale(var(--s, 1)) rotate(var(--r, 0deg));
    transform-origin: 50% 80%;
    will-change: transform;
  }
  .feat__media :global(.cover) {
    border-radius: var(--radius-l);
    box-shadow: 0 40px 80px -40px rgb(15 18 38 / 0.6);
  }
  .feat__media :global(img) {
    transition: transform 1200ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .feat:hover .feat__media :global(img) {
      transform: scale(1.04);
    }
  }
  .feat__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: var(--ink-2);
  }
  .feat__badge {
    padding: 0.2em 0.65em;
    border-radius: 999px;
    background: var(--marigold);
    color: #161a33;
    font-weight: 700;
  }
  .feat__title {
    font-size: clamp(2.8rem, 6vw, 5.2rem);
    margin-block: 0.9rem 0.6rem;
    width: fit-content;
  }
  .feat__tagline {
    font-size: clamp(1.25rem, 1.8vw, 1.6rem);
    line-height: 1.35;
    font-style: italic;
    margin-bottom: 1rem;
  }
  .feat__summary {
    max-width: 42ch;
  }
  .feat__more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    font-weight: 600;
    color: var(--delft);
  }
  .feat__more svg {
    transition: transform var(--t-base) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .feat:hover .feat__more svg {
      transform: translateX(4px);
    }
  }

  /* Project rows */
  .rows {
    border-top: 1px solid var(--line);
  }
  .row {
    border-bottom: 1px solid var(--line);
  }
  .row__link {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: "cover cover" "year arrow" "main main" "kind kind";
    gap: 0.4rem 1.5rem;
    padding-block: clamp(1.5rem, 3vw, 2.4rem);
    text-decoration: none;
  }
  @media (min-width: 900px) {
    .row__link {
      grid-template-columns: 9rem 1fr 14rem 2.5rem;
      grid-template-areas: "year main kind arrow";
      align-items: center;
    }
  }
  .row__year {
    grid-area: year;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
    font-size: 0.95rem;
  }
  .row__main {
    grid-area: main;
    display: grid;
    gap: 0.35rem;
  }
  .row__title {
    font-size: clamp(1.9rem, 4.2vw, 3.6rem);
    font-weight: 750;
    width: fit-content;
    transition: font-stretch 500ms var(--ease-out), color var(--t-base) var(--ease-out);
  }
  .row__tagline {
    font-size: 1.05rem;
  }
  .row__kind {
    grid-area: kind;
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .row__arrow {
    grid-area: arrow;
    justify-self: end;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--line);
    transition: background-color var(--t-base) var(--ease-out), color var(--t-base) var(--ease-out),
      transform 400ms var(--ease-out), box-shadow var(--t-base);
  }
  .row__cover {
    grid-area: cover;
    margin-bottom: 1rem;
  }
  @media (min-width: 900px) {
    .row__cover {
      display: none;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .row__link:hover .row__title {
      font-stretch: 118%;
      color: var(--delft);
    }
    .row__link:hover .row__arrow {
      background: var(--ink);
      color: var(--paper);
      box-shadow: none;
      transform: rotate(45deg);
    }
  }
  .row__link {
    transition: opacity var(--t-base) var(--ease-out);
  }

  /* Cursor-following preview, desktop only */
  .float {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 30;
    width: 22rem;
    pointer-events: none;
    display: none;
    transform: translate3d(var(--fx, -999px), var(--fy, -999px), 0);
    will-change: transform;
  }
  @media (min-width: 900px) and (hover: hover) and (pointer: fine) {
    .float {
      display: block;
    }
  }
  .float__inner {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-m);
    overflow: hidden;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.6) rotate(var(--rot, 0deg));
    filter: blur(8px);
    transition: opacity 250ms var(--ease-out), transform 450ms var(--ease-out), filter 250ms var(--ease-out);
    box-shadow: 0 30px 60px -20px rgb(15 18 38 / 0.55);
  }
  .float.is-on .float__inner {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1) rotate(var(--rot, 0deg));
    filter: none;
  }
  .float__slide {
    position: absolute;
    inset: 0;
    transform: translateY(100%);
    transition: transform 520ms var(--ease-drawer);
  }
  .float__slide.is-current {
    transform: none;
  }
  .float__slide.is-past {
    transform: translateY(-100%);
  }
  .float__slide :global(.cover) {
    border-radius: 0;
    height: 100%;
  }
</style>
