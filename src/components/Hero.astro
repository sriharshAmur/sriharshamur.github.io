---
import { Picture } from "astro:assets";
import CompanyLogo from "./CompanyLogo.astro";
import portrait from "../assets/portrait.png";
import { profile, experience } from "../data/site";
const current = experience[0];
const split = (word: string) => [...word];
const lines = [profile.firstName, profile.lastName];
let n = 0;
---

<section class="hero" aria-labelledby="hero-name">
  <div class="wrap hero__wrap">
    <p class="hero__now ui">
      <span class="hero__employer"><span class="hero__live" aria-hidden="true"></span><CompanyLogo company={current.logo} small /><span>{current.title} at {current.company}</span></span>
      <span class="hero__sep" aria-hidden="true"></span>
      <span class="hero__clock">Enschede, <time data-clock>--:--</time></span>
    </p>

    <h1 class="hero__name display" id="hero-name" data-proximity aria-label={profile.name}>
      {
        lines.map((line) => (
          <span class="hero__line" aria-hidden="true">
            {split(line).map((ch) =>
              ch === " " ? (
                <span class="hero__space"> </span>
              ) : (
                <span class="ch" data-letter={ch} style={`--i:${n++}`}>
                  <span class="ch__glyph">{ch}</span>
                </span>
              )
            )}
          </span>
        ))
      }
    </h1>

    <div class="hero__portrait" data-parallax data-cursor="nerd">
      <div class="hero__disc" data-depth="0.35" aria-hidden="true"></div>
      <Picture class="hero__photo" data-depth="0.8" src={portrait} formats={["avif", "webp"]} widths={[288, 460]} sizes="(min-width: 900px) 26rem, min(56vw, 18rem)" alt="" loading="eager" fetchpriority="high" />
      <div class="hello" data-hello>
        <button class="hello__button" type="button" data-hello-button aria-label="Say hello to the little dot">
          <span class="hello__face" aria-hidden="true">
            <span class="hello__eye"><span></span></span>
            <span class="hello__eye"><span></span></span>
            <svg class="hello__glasses" viewBox="0 0 48 48" fill="none" aria-hidden="true"><g stroke="var(--on-gold)" stroke-width="2.4"><rect x="7" y="14" width="15" height="17" rx="5" /><rect x="26" y="14" width="15" height="17" rx="5" /><path d="M22 20q2-2 4 0M4 18h3m34 0h3" /></g></svg>
            <svg class="hello__smile" viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M19 36q5 6 10 0" stroke="var(--on-gold)" stroke-width="2" stroke-linecap="round" /></svg>
          </span>
        </button>
        <span class="hello__message ui" data-hello-message aria-live="polite">Say hello</span>
      </div>
    </div>

    <div class="hero__foot">
      <p class="hero__intro">{profile.intro}</p>
      <div class="hero__cta">
        <a class="btn" href="/cv/">
          Read my CV
        </a>
        <a class="btn btn--ghost" href="#work">See selected work</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: 7rem 4rem;
    position: relative;
  }
  .hero__wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "portrait" "now" "name" "foot";
    gap: 1.5rem;
    position: relative;
  }
  @media (min-width: 900px) {
    .hero__wrap {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.42fr);
      grid-template-areas:
        "now portrait"
        "name portrait"
        "foot foot";
      column-gap: 2rem;
      row-gap: 2rem;
    }
  }

  /* Live status line */
  .hero__now {
    grid-area: now;
    align-self: end;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.95rem;
    color: var(--ink-2);
    animation: rise 700ms var(--ease-out) 100ms backwards;
  }
  .hero__employer { display: inline-flex; align-items: center; gap: 0.5rem; }
  .hero__live {
    position: relative;
    flex: none;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--success);
  }
  .hero__live::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: inherit;
    animation: ping 2.4s var(--ease-out) 2;
  }
  .hero__sep {
    width: 1.2rem;
    height: 1px;
    background: var(--line);
  }
  .hero__clock time {
    font-variant-numeric: tabular-nums;
  }

  /* A hidden, full-weight letter reserves each slot. The visible glyph can
     change width and weight without moving its neighbours or its hit target. */
  .hero__name {
    grid-area: name;
    font-size: clamp(2.75rem, 15.5vw, 14.5rem);
    line-height: 0.86;
    letter-spacing: -0.035em;
    font-weight: 850;
    position: relative;
    z-index: 2;
  }
  .hero__line {
    display: block;
    white-space: nowrap;
  }
  @media (min-width: 900px) {
    .hero__name {
      font-size: clamp(5rem, 10.4vw, 10rem);
    }
  }
  .hero__line + .hero__line {
    color: var(--accent-display);
  }
  .ch {
    display: inline-block;
    position: relative;
    font-stretch: 100%;
    font-weight: 850;
  }
  .ch::before {
    content: attr(data-letter);
    visibility: hidden;
  }
  .ch__glyph {
    display: inline-block;
    position: absolute;
    left: 50%;
    top: 0;
    translate: -50% 0;
    transform-origin: 50% 85%;
    animation: letter-in 1300ms var(--ease-out) backwards;
    animation-delay: calc(var(--i) * 28ms);
  }
  .hero__space {
    display: inline-block;
    width: 0.22em;
  }
  @keyframes letter-in {
    0% {
      opacity: 0;
      font-stretch: 50%;
      font-weight: 300;
      transform: translateY(0.3em);
    }
    35% { opacity: 1; }
    100% { font-stretch: 100%; font-weight: 850; transform: none; }
  }

  /* Portrait: a marigold sun with the cutout standing in front of it. */
  .hero__portrait {
    grid-area: portrait;
    position: relative;
    width: min(56vw, 18rem);
    aspect-ratio: 1;
    justify-self: start;
  }
  @media (min-width: 900px) {
    .hero__portrait {
      width: 100%;
      max-width: 26rem;
      justify-self: end;
      align-self: center;
    }
  }
  .hero__disc,
  .hero__photo {
    position: absolute;
    inset: 0;
    /* --px and --py are eased by site.ts; a transition here would fight it. */
    will-change: transform;
    transform: translate3d(var(--px, 0px), var(--py, 0px), 0);
  }
  .hello { display: none; }
  @media (hover: none), (pointer: coarse) {
    .hero__portrait { margin-bottom: 1.25rem; }
    :global(.js) .hello {
      position: absolute;
      right: -0.8rem;
      bottom: 0;
      z-index: 3;
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }
    .hello__button {
      position: relative;
      display: grid;
      place-items: center;
      width: 56px;
      height: 56px;
      border: 3px solid var(--paper);
      border-radius: 50%;
      background: var(--marigold);
      color: var(--on-gold);
      touch-action: manipulation;
      transition: transform 120ms var(--ease-out);
    }
    .hello__button:active { transform: scale(0.94); }
    .hello__face {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      width: 100%;
      height: 100%;
    }
    .hello__eye {
      display: grid;
      place-items: center;
      width: 12px;
      height: 17px;
      border-radius: 50%;
      background: #fff;
    }
    .hello__eye > span { width: 5px; height: 7px; border-radius: 50%; background: var(--on-gold); }
    .hello__glasses, .hello__smile { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 160ms ease; }
    .hello__glasses { transform: translateY(-2px); transition: opacity 160ms ease, transform 200ms var(--ease-out); }
    .hello.is-nerd .hello__glasses { opacity: 1; transform: none; }
    .hello.is-happy .hello__smile { opacity: 1; }
    .hello__message {
      position: absolute;
      top: calc(100% + 0.4rem);
      right: 0;
      width: max-content;
      max-width: min(15rem, 65vw);
      font-size: 0.75rem;
      line-height: 1.35;
      color: var(--ink-2);
    }
  }
  .hero__disc {
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, color-mix(in srgb, var(--marigold) 70%, #fff) 0%, var(--marigold) 55%);
    animation: disc-in 1000ms var(--ease-out) 30ms backwards;
  }
  .hero__photo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    clip-path: inset(-20% 0 0 0 round 0 0 50% 50%);
    animation: photo-in 800ms var(--ease-out) 80ms backwards;
  }
  @keyframes disc-in {
    from {
      transform: scale(0.4);
      opacity: 0;
    }
  }
  @keyframes photo-in {
    from {
      opacity: 0;
      transform: translateY(12%);
    }
  }

  .hero__foot {
    grid-area: foot;
    display: grid;
    gap: 2rem;
    align-items: end;
    margin-top: clamp(1rem, 3vw, 2.5rem);
  }
  @media (min-width: 900px) {
    .hero__foot {
      grid-template-columns: minmax(0, 36rem) auto;
      justify-content: space-between;
    }
  }
  .hero__intro {
    font-size: clamp(1.2rem, 1.6vw, 1.5rem);
    line-height: 1.45;
    max-width: 34ch;
    /* The intro is the largest text on screen, so it never starts invisible: it settles in from 0.6. */
    animation: settle 700ms var(--ease-out) 120ms backwards;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    animation: rise 700ms var(--ease-out) 160ms backwards;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  @keyframes settle {
    from {
      opacity: 0.6;
      transform: translateY(14px);
    }
  }
  @keyframes ping {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    70%,
    100% {
      transform: scale(3);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hello__button:active { transform: none; }
    .hero__live::after {
      display: none;
    }
  }
</style>
