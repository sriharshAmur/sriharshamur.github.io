---
// A project cover that follows the cursor while it is over a list of links.
// Links opt in with data-row={index into items}; site.ts does the moving.
// Desktop with a fine pointer only, and hidden from assistive technology:
// the links themselves carry the names.
import type { Work } from "../data/site";
import Cover from "./Cover.astro";
export interface Props {
  items: Work[];
}
const { items } = Astro.props;
---

<div class="float" aria-hidden="true" data-float>
  <div class="float__inner">
    {
      items.map((item, i) => (
        <div class="float__slide" data-slide={i}>
          <Cover item={item} sizes="26rem" />
        </div>
      ))
    }
  </div>
</div>

<style>
  .float {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 30;
    width: clamp(19rem, 24vw, 26rem);
    pointer-events: none;
    display: none;
    /* Position and tilt are written every frame by site.ts, so no transition here. */
    transform: translate3d(var(--fx, -999px), var(--fy, -999px), 0) rotate(var(--rot, 0deg));
    will-change: transform;
  }
  @media (min-width: 900px) and (hover: hover) and (pointer: fine) {
    .float {
      display: block;
    }
  }
  @media print {
    .float {
      display: none !important;
    }
  }
  .float__inner {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-m);
    overflow: hidden;
    opacity: 0;
    translate: -50% -50%;
    transform: scale(0.82);
    transition: opacity 200ms var(--ease-out), transform 360ms var(--ease-out);
    box-shadow: 0 30px 60px -22px rgb(var(--shadow) / 0.55), 0 0 0 1px rgb(var(--shadow) / 0.06);
  }
  .float.is-on .float__inner {
    opacity: 1;
    transform: none;
  }
  .float__slide {
    position: absolute;
    inset: 0;
    transform: translateY(100%);
    transition: transform 520ms var(--ease-drawer);
  }
  .float__slide.is-current {
    transform: none;
  }
  .float__slide.is-past {
    transform: translateY(-100%);
  }
  .float__slide :global(.cover) {
    border-radius: 0;
    height: 100%;
  }
</style>
