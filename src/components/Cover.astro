---
// Project artwork. Real screenshots when there are any, otherwise a small
// hand-built illustration of the product so every project has a face.
import type { Work } from "../data/site";
export interface Props {
  item: Work;
  vt?: boolean;
  eager?: boolean;
}
const { item, vt = false, eager = false } = Astro.props;
const cover = item.cover;
const style = `--tint:${item.tint};${vt ? `view-transition-name:cover-${item.slug};` : ""}`;
const bars = [62, 88, 45, 74, 96, 58, 81, 39, 67];
---

<div class:list={["cover", cover.type === "mock" && `cover--${cover.variant}`]} style={style}>
  {
    cover.type === "image" ? (
      <img src={cover.src} alt={cover.alt} loading={eager ? "eager" : "lazy"} decoding="async" width="1600" height="1000" />
    ) : cover.variant === "viz" ? (
      <div class="mock mock--viz" role="img" aria-label="Illustration of a dashboard extension with a bar chart">
        <div class="mock__chrome"><i></i><i></i><i></i></div>
        <div class="viz">
          <div class="viz__side">
            <span class="viz__k">Revenue by region</span>
            <span class="viz__v">€4.2M</span>
            <span class="viz__pill" />
            <span class="viz__pill viz__pill--short" />
            <span class="viz__pill" />
          </div>
          <div class="viz__chart">
            {bars.map((h, i) => (
              <span class="viz__bar" style={`--h:${h}%;--i:${i}`} />
            ))}
          </div>
        </div>
      </div>
    ) : cover.variant === "jobs" ? (
      <div class="mock mock--jobs" role="img" aria-label="Illustration of a job board with listings">
        <div class="mock__chrome"><i></i><i></i><i></i></div>
        <div class="jobs">
          <div class="jobs__search"><span /></div>
          {[0, 1, 2].map((i) => (
            <div class="jobs__row" style={`--i:${i}`}>
              <span class="jobs__logo" />
              <span class="jobs__lines"><span /><span /></span>
              <span class="jobs__cta" />
            </div>
          ))}
        </div>
      </div>
    ) : (
      <div class="mock mock--chat" role="img" aria-label="Illustration of a team chat application">
        <div class="mock__chrome"><i></i><i></i><i></i></div>
        <div class="chat">
          <div class="chat__rail">
            <span />
            <span />
            <span />
          </div>
          <div class="chat__thread">
            <span class="chat__msg" style="--i:0;--w:62%" />
            <span class="chat__msg chat__msg--me" style="--i:1;--w:48%" />
            <span class="chat__msg" style="--i:2;--w:70%" />
            <span class="chat__msg chat__msg--me" style="--i:3;--w:36%" />
            <span class="chat__input" />
          </div>
        </div>
      </div>
    )
  }
</div>

<style>
  .cover {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-m);
    background: var(--tint);
    isolation: isolate;
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cover--viz {
    background: linear-gradient(140deg, #2849c9, #1a2e8a);
  }
  .cover--jobs {
    background: linear-gradient(140deg, #ffc54d, #f29b16);
  }
  .cover--chat {
    background: linear-gradient(140deg, #6b6fd6, #3f42a8);
  }

  .mock {
    position: absolute;
    inset: 12% 9% -8% 9%;
    border-radius: 12px 12px 0 0;
    background: #f7f8fb;
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.45);
    overflow: hidden;
    transition: transform 700ms var(--ease-out);
  }
  .mock__chrome {
    display: flex;
    gap: 5px;
    padding: 9px 11px;
    background: #e8eaf0;
  }
  .mock__chrome i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #c9ccd8;
  }

  /* Viz extension */
  .viz {
    display: grid;
    grid-template-columns: 34% 1fr;
    gap: 6%;
    height: calc(100% - 26px);
    padding: 6%;
  }
  .viz__side {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-family: var(--display);
    color: #161a33;
  }
  .viz__k {
    font-size: clamp(0.5rem, 1vw, 0.75rem);
    color: #626983;
  }
  .viz__v {
    font-weight: 800;
    font-size: clamp(0.9rem, 2.2vw, 1.6rem);
    line-height: 1;
    margin-bottom: 6px;
  }
  .viz__pill {
    height: 7px;
    border-radius: 4px;
    background: #dfe3f0;
  }
  .viz__pill--short {
    width: 60%;
    background: #ffb020;
  }
  .viz__chart {
    display: flex;
    align-items: flex-end;
    gap: 5%;
    border-bottom: 1.5px solid #dfe3f0;
  }
  .viz__bar {
    flex: 1;
    height: var(--h);
    border-radius: 4px 4px 0 0;
    background: #2849c9;
    transform-origin: 50% 100%;
    transition: transform 700ms var(--ease-out);
    transition-delay: calc(var(--i) * 40ms);
  }
  .viz__bar:nth-child(5) {
    background: #ffb020;
  }

  /* Job board */
  .jobs {
    display: grid;
    gap: 9px;
    padding: 6%;
  }
  .jobs__search {
    height: 22px;
    border-radius: 999px;
    background: #fff;
    box-shadow: inset 0 0 0 1.5px #e1e4ee;
    padding: 7px 12px;
  }
  .jobs__search span {
    display: block;
    width: 40%;
    height: 100%;
    border-radius: 4px;
    background: #e1e4ee;
  }
  .jobs__row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px;
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 1px 0 #e6e8f0;
    transition: transform 600ms var(--ease-out);
    transition-delay: calc(var(--i) * 50ms);
  }
  .jobs__logo {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: #161a33;
    flex: none;
  }
  .jobs__row:nth-child(3) .jobs__logo {
    background: #2849c9;
  }
  .jobs__row:nth-child(4) .jobs__logo {
    background: #f29b16;
  }
  .jobs__lines {
    flex: 1;
    display: grid;
    gap: 5px;
  }
  .jobs__lines span {
    height: 6px;
    border-radius: 3px;
    background: #d6d9e4;
  }
  .jobs__lines span + span {
    width: 55%;
    background: #eceef3;
  }
  .jobs__cta {
    width: 38px;
    height: 16px;
    border-radius: 999px;
    background: #ffb020;
  }

  /* Chat */
  .chat {
    display: grid;
    grid-template-columns: 16% 1fr;
    height: calc(100% - 26px);
  }
  .chat__rail {
    display: grid;
    align-content: start;
    justify-items: center;
    gap: 10px;
    padding-top: 14px;
    background: #ebebf7;
  }
  .chat__rail span {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    background: #5b5fc7;
    opacity: 0.35;
  }
  .chat__rail span:first-child {
    opacity: 1;
  }
  .chat__thread {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 8% 7% 0;
  }
  .chat__msg {
    width: var(--w);
    height: 16px;
    border-radius: 8px 8px 8px 2px;
    background: #e3e4f2;
    transition: transform 500ms var(--ease-out), opacity 500ms var(--ease-out);
    transition-delay: calc(var(--i) * 60ms);
  }
  .chat__msg--me {
    align-self: flex-end;
    border-radius: 8px 8px 2px 8px;
    background: #5b5fc7;
  }
  .chat__input {
    margin-top: auto;
    margin-bottom: 8%;
    height: 20px;
    border-radius: 6px;
    box-shadow: inset 0 0 0 1.5px #e1e4ee;
  }

  /* When the parent card is hovered, the illustrations come alive a little. */
  @media (hover: hover) and (pointer: fine) {
    :global(.is-hot) .mock {
      transform: translateY(-4%);
    }
    :global(.is-hot) .viz__bar {
      transform: scaleY(0.6);
    }
    :global(.is-hot) .viz__bar:nth-child(odd) {
      transform: scaleY(1.05);
    }
    :global(.is-hot) .jobs__row {
      transform: translateX(4%);
    }
    :global(.is-hot) .chat__msg {
      transform: translateY(-6px);
    }
  }
</style>
