---
import { technologyLinks } from "../data/cv-links";
interface Props { tools: string[]; class?: string; }
const { tools, class: className = "tags" } = Astro.props;
---
<ul class={className} role="list">
  {tools.map((tool) => (
    <li>{technologyLinks[tool] ? <a href={technologyLinks[tool]}>{tool}</a> : tool}</li>
  ))}
</ul>
