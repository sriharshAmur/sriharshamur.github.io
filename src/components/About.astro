---
import { profile } from "../data/site";
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="wrap about__wrap">
    <figure class="about__photo" data-reveal>
      <img src="/img/portrait-cv.png" alt={`Portrait of ${profile.name}`} width="250" height="250" loading="lazy" />
    </figure>
    <div class="about__text">
      <h2 class="stretch" id="about-title" data-stretch>Hi, I'm Sri Harsh</h2>
      <div class="about__body">
        <p data-reveal style="--i:0">
          I grew up in New Delhi and came to Enschede in 2019 to study at the University of Twente. The Netherlands
          stuck, and so did building things for the web.
        </p>
        <p data-reveal style="--i:1">
          My work sits where interfaces meet systems. I like the front end enough to sweat an easing curve, and the
          back end enough to care what happens when a Kafka consumer falls behind. Working as a Product Owner
          taught me to ask whether something is worth building before asking how.
        </p>
        <p data-reveal style="--i:2">
          Outside work I build side projects to scratch my own itches. The latest turns a decade of Google Maps history
          into a story you can scroll through.
        </p>
      </div>
      <div class="about__cta" data-reveal style="--i:3">
        <a class="btn" href="/cv">Read the full CV</a>
        <a class="btn btn--ghost" href="#contact">Get in touch</a>
      </div>
    </div>
  </div>
</section>

<style>
  .about__wrap {
    display: grid;
    gap: clamp(2rem, 6vw, 5rem);
  }
  @media (min-width: 900px) {
    .about__wrap {
      grid-template-columns: minmax(0, 0.8fr) 1.4fr;
      align-items: start;
    }
  }
  .about__photo {
    position: relative;
    max-width: 24rem;
    border-radius: var(--radius-l);
    overflow: hidden;
    background: var(--marigold);
    rotate: -3deg;
    box-shadow: 0 30px 60px -30px rgb(15 18 38 / 0.5);
    transition: rotate 700ms var(--ease-out), transform 700ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .about__photo:hover {
      rotate: 0deg;
      transform: scale(1.02);
    }
  }
  @media (min-width: 900px) {
    .about__photo {
      position: sticky;
      top: 7rem;
    }
  }
  .about__photo img {
    width: 100%;
    height: auto;
  }
  .about__body {
    display: grid;
    gap: 1.2rem;
    margin-top: 2rem;
    max-width: 38rem;
    font-size: clamp(1.15rem, 1.4vw, 1.3rem);
  }
  .about__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
</style>
