---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import CursorCompanion from "../components/CursorCompanion.astro";
import { profile } from "../data/site";
// Imported so the URLs are content-hashed, which lets them be cached for a year.
import anybody from "../fonts/anybody-latin.woff2?url";
import newsreader from "../fonts/newsreader-latin.woff2?url";
import publicSans from "../fonts/public-sans-latin.woff2?url";

export interface Props {
  title?: string;
  description?: string;
  active?: "home" | "work" | "cv";
  image?: string;
  imageAlt?: string;
  showFooter?: boolean;
}

const {
  title = `${profile.name} · ${profile.role}`,
  description = profile.intro,
  active = "home",
  image = "/img/og.png",
  imageAlt = "Sri Harsh Amur, full-stack developer in Enschede, the Netherlands",
  showFooter = true,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#faf9f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161514" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:image:alt" content={imageAlt} />
    {/* Fonts above the fold: Newsreader everywhere (the CV name and lede use it), plus each page's UI face. */}
    <link rel="preload" href={active === "cv" ? publicSans : anybody} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={newsreader} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (() => {
        const d = document.documentElement;
        let t = null;
        try { t = localStorage.getItem("theme"); } catch (e) {}
        if (!t) t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        if (t === "dark") d.classList.add("dark");
      })();
    </script>
  </head>
  <body data-page={active}>
    <a class="skip ui" href="#main">Skip to content</a>
    <Nav active={active} />
    <main id="main">
      <slot />
    </main>
    {showFooter && <Footer />}
    {active !== "cv" && <CursorCompanion />}
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>

<style>
  .skip {
    position: fixed;
    left: 1rem;
    top: 1rem;
    z-index: 100;
    padding: 0.6rem 1rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    transform: translateY(-200%);
    transition: transform var(--t-base) var(--ease-out);
  }
  .skip:focus {
    transform: none;
  }
</style>
