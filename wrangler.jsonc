{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sriharsh-portfolio",
  "account_id": "597077cd59b8f204111471a20fdd88b2",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-04",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "sriharsh.com/*", "zone_name": "sriharsh.com" },
    { "pattern": "www.sriharsh.com/*", "zone_name": "sriharsh.com" }
  ]
}
